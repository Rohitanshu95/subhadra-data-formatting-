# ==========================================
# APBS Processing Engine Configuration Example
# ==========================================

PORT=8080
HOST=0.0.0.0
DEBUG=True

# ── SQL Database Configuration ──
DATABASE_URL=sqlite:///./storage/apbs_database.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apbs_db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/apbs_db

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
IMPORT_CHUNK_SIZE=5000

# ── Celery & Redis Task Queue ──
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
WORKER_COUNT=4

# ── Batch & Parsing Limits ──
MAX_FILES_PER_BATCH=100
MAX_BATCH_SIZE_GB=3
APBS_RECORD_LENGTH=177
STORAGE_BASE_DIR=storage
OUTPUT_DELIMITER=|

# ── Security & Retention ──
JWT_SECRET=APBS_SUPER_SECRET_PRODUCTION_KEY_177_CHARS
JWT_EXPIRE_MINUTES=1440
RETENTION_DAYS_INPUT=30
